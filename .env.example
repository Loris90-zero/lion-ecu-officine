# Copia questo file in .env.local per lavorare in locale.
# Su Vercel inserisci le stesse variabili in Settings → Environment Variables.
# NON incollare mai queste chiavi in chat o in email.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Indirizzo pubblico dell'app (senza barra finale)
NEXT_PUBLIC_SITE_URL=https://app.lionecusystem.it

# Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Stripe (dashboard.stripe.com → Developers)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Quante ricerche centralina può fare un'officina in 24 ore
LIMITE_RICERCHE_GIORNO=30
